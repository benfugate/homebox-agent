# Copy to deploy/.env (git-ignored) and fill in.

# SSH host (as in ~/.ssh/config) of the Unraid server that runs the agent.
DEPLOY_HOST=unraid

# Homebox as reachable from that server, and an API key from Homebox's Profile page.
HOMEBOX_URL=http://192.0.2.10:3100
HOMEBOX_API_KEY=hb_...

# Optional
# AGENT_LOG_MODE=changes
# AGENT_FEEDBACK=on
# TRANSCRIPT_RETENTION_DAYS=365
# TZ=America/Chicago
# APPDATA=/mnt/user/appdata/homebox-agent
# CONTAINER_NAME=homebox-agent
# IMAGE=ghcr.io/benfugate/homebox-agent:latest
